        "matchDepTypes": [
          "devDependencies"
        ],
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "semanticCommitType": "build",
        "commitMessageSuffix": "",
        "addLabels": [
          "dep:build",
          "automerge"
        ],
        "automerge": true,
        "matchManagers": [
          "npm"
        ],
        "matchPackageNames": [
