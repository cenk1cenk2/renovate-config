          "/^vitepress/",
          "/^markdown-it/"
        ],
        "groupName": "node all docs dependency updates",
        "groupSlug": "node-docs",
        "schedule": [
          "at any time"
        ]
      },
      {
        "matchManagers": [
          "npm"
        ],
        "rangeStrategy": "widen",
        "matchDepNames": [
          "pnpm",
          "yarn",
          "npm",
          "bun"
        ],
        "addLabels": [
          "dep:package-manager",
          "automerge"
        ],
        "commitMessageSuffix": "[skip ci]",
        "automerge": true,
        "groupName": "node all package manager",
        "groupSlug": "node-package-manager",
        "schedule": [
          "at any time"
        ]
      },
      {
        "matchManagers": [
          "npm"
        ],
        "matchDepTypes": [
          "devDependencies"
        ],
        "rangeStrategy": "bump"
      }
    ]
  },
  "group-node-peer-dependencies": {
    "packageRules": [
      {
        "matchDepTypes": [
          "peerDependencies",
          "optionalDependencies"
        ],
        "rangeStrategy": "widen",
        "commitMessageSuffix": "[skip ci]",
        "addLabels": [
          "dep:peer",
          "automerge"
        ],
        "automerge": true,
        "matchManagers": [
          "npm"
        ],
        "matchPackageNames": [
          "*"
        ],
        "groupName": "node all peer dependency updates",
        "groupSlug": "node-peer",
        "enabled": false,
        "schedule": [
