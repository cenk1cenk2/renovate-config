        ],
        "matchPackageNames": [
          "prometheus-blackbox-exporter",
          "alloy",
          "gitlab-runner"
        ],
        "addLabels": [
          "automerge"
        ]
      }
    ]
  },
  "group-helm-minor": {
    "packageRules": [
      {
        "enabled": true,
        "automerge": false,
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "additionalBranchPrefix": "{{packageFileDir}}-",
        "groupName": "helm all minor dependency updates",
        "commitMessageExtra": "to {{{newValue}}} [{{packageFileDir}}]",
        "extends": [
          ":semanticCommitTypeAll(feat)"
        ],
        "groupSlug": "helm-minor",
        "matchManagers": [
          "helmv3"
        ]
      },
      {
        "enabled": true,
        "automerge": true,
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "additionalBranchPrefix": "{{packageFileDir}}-",
        "groupName": "helm all minor automerge dependency updates",
        "commitMessageExtra": "to {{{newValue}}} [{{packageFileDir}}]",
        "extends": [
          ":semanticCommitTypeAll(feat)"
        ],
        "groupSlug": "helm-minor-automerge",
