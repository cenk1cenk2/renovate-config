        "groupName": "node all build dependency updates",
        "groupSlug": "node-build",
        "schedule": [
          "at any time"
        ]
      },
      {
        "matchDepTypes": [
          "devDependencies"
        ],
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "semanticCommitType": "docs",
        "commitMessageSuffix": "",
        "addLabels": [
          "dep:docs",
          "automerge"
        ],
        "automerge": true,
        "matchManagers": [
          "npm"
        ],
        "matchPackageNames": [
