{
  "default": {
    "enabledManagers": [
      "ansible-galaxy",
      "argocd",
      "dockerfile",
      "gitlabci",
      "gitlabci-include",
      "gomod",
      "helmv3",
      "helm-values",
      "kubernetes",
      "kustomize",
      "npm",
      "ocb",
      "pep621",
      "custom.regex",
      "cargo",
      "terraform"
    ],
    "extends": [
      "local>renovate/renovate-config:default/base",
      "local>renovate/renovate-config:default/lock-file",
      "local>renovate/renovate-config:default/manager-ansible-galaxy",
      "local>renovate/renovate-config:default/manager-argocd",
      "local>renovate/renovate-config:default/manager-dockerfile",
      "local>renovate/renovate-config:default/manager-gitlab-ci",
      "local>renovate/renovate-config:default/manager-go",
      "local>renovate/renovate-config:default/manager-helm",
      "local>renovate/renovate-config:default/manager-kubernetes",
      "local>renovate/renovate-config:default/manager-kustomize",
      "local>renovate/renovate-config:default/manager-node",
      "local>renovate/renovate-config:default/manager-otel-builder",
      "local>renovate/renovate-config:default/manager-python",
      "local>renovate/renovate-config:default/manager-rust",
      "local>renovate/renovate-config:default/manager-terraform",
      "local>renovate/renovate-config:default/datasource-docker"
    ]
  },
  "base": {
    "extends": [
      "config:recommended",
      ":configMigration",
      ":dependencyDashboard",
      ":disableRateLimiting",
      ":updateNotScheduled",
      ":enableVulnerabilityAlerts"
    ],
    "timezone": "Europe/Vienna",
    "semanticCommits": "enabled",
    "reviewers": [
      "cenk1cenk2",
      "labrat"
    ],
    "labels": [
      "renovate"
    ],
    "prCreation": "immediate",
    "packageRules": [
      {
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest",
          "pinDigest",
          "bump",
          "lockfileUpdate"
        ],
        "addLabels": [
          "update:minor"
        ]
      },
      {
        "matchUpdateTypes": [
          "major",
          "replacement"
        ],
        "addLabels": [
          "update:major"
        ]
      }
    ]
  },
  "lock-file": {
    "lockFileMaintenance": {
      "enabled": true,
      "automerge": true,
      "commitMessageSuffix": "[skip ci]",
      "addLabels": [
        "dep:lock",
        "automerge"
      ],
      "schedule": [
        "before 1am"
      ]
    }
  },
  "no-tests": {
    "ignoreTests": true
  },
  "branch-develop": {
    "baseBranchPatterns": [
      "develop"
    ]
  },
  "branch-beta": {
    "baseBranchPatterns": [
      "beta"
    ]
  },
  "manager-node": {
    "enabledManagers": [
      "npm"
    ],
    "extends": [
      "local>renovate/renovate-config:default/ring-node-none",
      "local>renovate/renovate-config:default/ring-node-slow",
      "local>renovate/renovate-config:default/ring-node-fast",
      "local>renovate/renovate-config:default/group-node-dev-dependencies",
      "local>renovate/renovate-config:default/group-node-minor-dependencies",
      "local>renovate/renovate-config:default/group-node-peer-dependencies"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "npm"
        ],
        "addLabels": [
          "renovate",
          "manager:node"
        ]
      },
      {
        "matchManagers": [
          "npm"
        ],
        "matchPackageNames": [
          "*",
          "!/^@cenk1cenk2//",
          "!/listr2/",
          "!/^@cenk1cenk2-.*//",
          "!/^@kilic.dev//"
        ],
        "minimumReleaseAge": "7 days"
      }
    ]
  },
  "manager-go": {
    "enabledManagers": [
      "gomod"
    ],
    "extends": [
      "local>renovate/renovate-config:default/ring-go-slow",
      "local>renovate/renovate-config:default/ring-go-fast",
      "local>renovate/renovate-config:default/group-go-minor-dependencies"
    ],
    "postUpdateOptions": [
      "gomodTidy",
      "gomodUpdateImportPaths"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "gomod"
        ],
        "addLabels": [
          "renovate",
          "manager:go"
        ]
      }
    ]
  },
  "manager-python": {
    "enabledManagers": [
      "pep621"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "pep621"
        ],
        "addLabels": [
          "renovate",
          "manager:python"
        ]
      },
      {
        "matchManagers": [
          "pep621"
        ],
        "minimumReleaseAge": "7 days"
      }
    ]
  },
  "manager-rust": {
    "enabledManagers": [
      "cargo"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "cargo"
        ],
        "addLabels": [
          "renovate",
          "manager:rust"
        ]
      }
    ]
  },
  "manager-kubernetes": {
    "enabledManagers": [
      "kubernetes"
    ],
    "kubernetes": {
      "managerFilePatterns": [
        "/\\.deploy\\/.*\\/.*\\.ya?ml/",
        "/!(^\\.deploy\\/.*\\/kustomization\\.ya?ml$)/",
        "/!(^\\.deploy\\/.*\\/templates\\/)/",
        "/!(^\\.deploy\\/.*\\/files\\/)/",
        "/!(^\\.deploy\\/.*\\/values\\/)/",
        "/!(^\\.deploy\\/.*\\/values\\.ya?ml$)/",
        "/!(^\\.deploy\\/.*\\/chart\\.ya?ml$)/"
      ]
    },
    "packageRules": [
      {
        "matchManagers": [
          "kubernetes"
        ],
        "addLabels": [
          "renovate",
          "manager:kubernetes",
          "area:infrastructure"
        ]
      }
    ]
  },
  "manager-kustomize": {
    "enabledManagers": [
      "kustomize"
    ],
    "extends": [
      "local>renovate/renovate-config:default/group-kustomize-minor-helm-releases",
      "local>renovate/renovate-config:default/group-kustomize-major"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "kustomize"
        ],
        "addLabels": [
          "renovate",
          "manager:kustomize",
          "area:infrastructure"
        ],
        "schedule": [
          "at any time"
        ]
      }
    ]
  },
  "manager-helm": {
    "enabledManagers": [
      "helmv3",
      "helm-values"
    ],
    "postUpdateOptions": [
      "helmUpdateSubChartArchives"
    ],
    "extends": [
      "local>renovate/renovate-config:default/group-helm-minor",
      "local>renovate/renovate-config:default/group-helm-major"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "helmv3",
          "helm-values"
        ],
        "addLabels": [
          "renovate",
          "manager:helm",
          "area:infrastructure"
        ],
        "schedule": [
          "at any time"
        ]
      }
    ]
  },
  "manager-terraform": {
    "enabledManagers": [
      "terraform",
      "custom.regex"
    ],
    "extends": [
      "local>renovate/renovate-config:default/manager-terraform-custom",
      "local>renovate/renovate-config:default/group-terraform-minor-helm-releases",
      "local>renovate/renovate-config:default/group-terraform-minor-providers",
      "local>renovate/renovate-config:default/group-terraform-minor-modules",
      "local>renovate/renovate-config:default/group-terraform-major"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "terraform"
        ],
        "addLabels": [
          "renovate",
          "manager:terraform",
          "area:infrastructure"
        ],
        "schedule": [
          "at any time"
        ]
      },
      {
        "matchManagers": [
          "custom.regex"
        ],
        "matchDepTypes": [
          "terraform-manager-git-monorepo"
        ],
        "addLabels": [
          "renovate",
          "manager:terraform",
          "area:infrastructure"
        ],
        "schedule": [
          "at any time"
        ]
      }
    ]
  },
  "manager-terraform-custom": {
    "customManagers": [
      {
        "depTypeTemplate": "terraform-manager-git-monorepo",
        "customType": "regex",
        "managerFilePatterns": [
          "/\\.tf$/"
        ],
        "matchStringsStrategy": "any",
        "matchStrings": [
          "\"git::git@(?<registryUrl>[^:]+):(?<packageName>[^.]+)(\\.git)?\\/\\/.*\\?ref=(?<depName>.+)@(?<currentValue>[^\"]+)\""
        ],
        "extractVersionTemplate": "^{{{depName}}}@(?<version>.*)$",
        "registryUrlTemplate": "https://{{{registryUrl}}}",
        "datasourceTemplate": "gitlab-tags",
        "versioningTemplate": "semver"
      }
    ]
  },
  "manager-ansible-galaxy": {
    "enabledManagers": [
      "ansible-galaxy"
    ],
    "extends": [
      "local>renovate/renovate-config:default/group-ansible-galaxy-minor-roles"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "ansible-galaxy"
        ],
        "addLabels": [
          "renovate",
          "manager:ansible-galaxy",
          "area:infrastructure"
        ]
      }
    ]
  },
  "manager-dockerfile": {
    "enabledManagers": [
      "dockerfile"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "dockerfile"
        ],
        "addLabels": [
          "renovate",
          "manager:dockerfile"
        ]
      }
    ]
  },
  "manager-gitlab-ci": {
    "enabledManagers": [
      "gitlabci-include",
      "gitlabci",
      "custom.regex"
    ],
    "extends": [
      "local>renovate/renovate-config:default/manager-gitlab-ci-custom",
      "local>renovate/renovate-config:default/group-gitlab-ci-minor-updates"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "gitlabci-include",
          "gitlabci"
        ],
        "addLabels": [
          "renovate",
          "manager:gitlab-ci",
          "area:pipelines"
        ]
      },
      {
        "matchManagers": [
          "custom.regex"
        ],
        "matchDepTypes": [
          "gitlab-ci-manager-git-monorepo"
        ],
        "addLabels": [
          "renovate",
          "manager:gitlab-ci",
          "area:pipelines"
        ]
      }
    ]
  },
  "manager-gitlab-ci-custom": {
    "customManagers": [
      {
        "depTypeTemplate": "gitlab-ci-manager-git-monorepo",
        "customType": "regex",
        "managerFilePatterns": [
          "/\\.gitlab-ci\\.ya?ml$/",
          "/\\.gitlab-ci\\..*\\.ya?ml$/"
        ],
        "matchStringsStrategy": "any",
        "matchStrings": [
          "project:\\s+['\"]?(?<packageName>[^'\"\\s]+)['\"]?\\s*ref:\\s+['\"]?(?<depName>[^@]+)@(?<currentValue>[^'\"\\s]+)['\"]?"
        ],
        "registryUrlTemplate": "https://gitlab.kilic.dev/",
        "extractVersionTemplate": "^{{{depName}}}@(?<version>.*)$",
        "datasourceTemplate": "gitlab-tags",
        "versioningTemplate": "semver"
      }
    ]
  },
  "manager-otel-builder": {
    "enabledManagers": [
      "ocb"
    ],
    "packageRules": [
      {
        "matchPackageNames": [
          "*"
        ],
        "groupName": "otel-builder all minor dependency updates",
        "groupSlug": "otel-builder-minor",
        "matchUpdateTypes": [
          "minor",
          "patch",
          "digest"
        ],
        "addLabels": [
          "automerge"
        ],
        "automerge": true,
        "matchManagers": [
          "ocb"
        ],
        "schedule": [
          "before 1am"
        ]
      },
      {
        "matchManagers": [
          "ocb"
        ],
        "addLabels": [
          "renovate",
          "manager:otel-builder",
          "area:infrastructure"
        ]
      }
    ]
  },
  "manager-argocd": {
    "enabledManagers": [
      "argocd"
    ],
    "extends": [
      "local>renovate/renovate-config:default/group-argocd-minor",
      "local>renovate/renovate-config:default/group-argocd-major"
    ],
    "packageRules": [
      {
        "matchManagers": [
          "argocd"
        ],
        "addLabels": [
          "renovate",
          "manager:argocd",
          "area:infrastructure"
        ],
        "schedule": [
          "at any time"
        ]
      }
    ]
  },
  "datasource-docker": {
    "packageRules": [
      {
        "matchDatasources": [
          "docker"
        ],
        "addLabels": [
          "renovate",
          "datasource:docker"
        ]
      },
      {
        "enabled": true,
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "addLabels": [
          "automerge"
        ],
        "groupName": "docker datasource minor dependency updates",
        "groupSlug": "docker-minor",
        "automerge": true,
        "matchDatasources": [
          "docker"
        ],
        "matchPackageNames": [
          "ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib",
          "renovate/renovate"
        ],
        "schedule": [
          "at any time"
        ]
      }
    ]
  },
  "group-node-minor-dependencies": {
    "packageRules": [
      {
        "matchDepTypes": [
          "dependencies"
        ],
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "addLabels": [
          "automerge"
        ],
        "automerge": true,
        "matchManagers": [
          "npm"
        ],
        "matchPackageNames": [
          "*"
        ],
        "groupName": "node all minor dependency updates",
        "groupSlug": "node-minor",
        "schedule": [
          "before 1am"
        ]
      },
      {
        "matchManagers": [
          "npm"
        ],
        "matchDepTypes": [
          "dependencies"
        ],
        "rangeStrategy": "bump"
      }
    ]
  },
  "group-node-dev-dependencies": {
    "packageRules": [
      {
        "matchDepTypes": [
          "devDependencies"
        ],
        "matchUpdateTypes": [
          "minor",
          "patch",
          "pin",
          "digest"
        ],
        "commitMessageSuffix": "[skip ci]",
        "addLabels": [
          "dep:dev",
          "automerge"
        ],
        "automerge": true,
        "matchManagers": [
          "npm"
        ],
        "matchPackageNames": [
          "*"
        ],
        "groupName": "node all development dependency updates",
        "groupSlug": "node-dev",
        "schedule": [
          "at any time"
        ]
      },
