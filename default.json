        "groupSlug": "go-minor",
        "schedule": [
          "before 1am"
        ]
      }
    ]
  },
  "group-kustomize-minor-helm-releases": {
    "packageRules": [
      {
        "enabled": true,
        "automerge": false,
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "additionalBranchPrefix": "{{packageFileDir}}-",
        "groupName": "kustomize all minor dependency updates",
        "commitMessageExtra": "to {{{newValue}}} [{{packageFileDir}}]",
        "extends": [
          ":semanticCommitTypeAll(feat)"
        ],
        "groupSlug": "kustomize-minor",
        "matchManagers": [
          "kustomize"
        ],
        "matchDepTypes": [
          "HelmChart"
        ]
      },
      {
        "enabled": true,
        "automerge": true,
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "additionalBranchPrefix": "{{packageFileDir}}-",
        "groupName": "kustomize all minor automerge dependency updates",
        "commitMessageExtra": "to {{{newValue}}} [{{packageFileDir}}]",
        "extends": [
          ":semanticCommitTypeAll(feat)"
        ],
        "groupSlug": "kustomize-minor-automerge",
        "matchManagers": [
          "kustomize"
        ],
        "matchDepTypes": [
          "HelmChart"
        ],
        "matchSourceUrls": [
          "https://github.com/prometheus-community/helm-charts",
          "https://github.com/grafana/helm-charts",
          "https://gitlab.com/gitlab-org/charts/gitlab-runner"
        ],
        "matchPackageNames": [
          "prometheus-blackbox-exporter",
          "alloy",
          "gitlab-runner"
        ],
        "addLabels": [
          "automerge"
        ]
      }
    ]
  },
  "group-kustomize-major": {
    "packageRules": [
      {
        "enabled": true,
        "automerge": false,
        "matchUpdateTypes": [
          "major"
        ],
        "additionalBranchPrefix": "{{packageFileDir}}-",
        "groupName": "kustomize all major dependency updates",
        "commitMessageExtra": "to {{{newValue}}} [{{packageFileDir}}]",
        "extends": [
          ":semanticCommitTypeAll(perf)"
        ],
        "groupSlug": "kustomize-major",
        "matchManagers": [
          "kustomize"
        ],
        "matchDepTypes": [
          "HelmChart"
        ]
      },
      {
        "enabled": true,
        "automerge": true,
        "matchUpdateTypes": [
          "major"
        ],
        "additionalBranchPrefix": "{{packageFileDir}}-",
        "groupName": "kustomize all major automerge dependency updates",
