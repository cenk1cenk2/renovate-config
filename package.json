{
  "name": "@cenk1cenk2/renovate-config",
  "version": "5.0.0",
  "description": "Renovate configuration generator for repositories.",
  "author": "Cenk Kilic",
  "license": "GPL-3.0-or-later",
  "repository": "https://gitlab.kilic.dev/renovate/renovate-config",
  "type": "module",
  "bin": {
    "renovate-config-generator": "./bin/run.js"
  },
  "files": [
    "/config",
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "dev": "./bin/dev.js",
    "start": "./bin/run.js",
    "build": "tsdown",
    "dev:start": "tsdown --watch src/",
    "format": "prettier --log-level warn --write ./ && eslint --fix ./src",
    "lint": "eslint ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "manifest": "oclif manifest",
    "test:watch": "vitest"
  },
  "oclif": {
    "bin": "renovate-config-generator",
    "dirname": "renovate-config-generator",
    "commands": {
      "strategy": "single",
      "target": "./dist/commands/index.js"
    },
    "plugins": [],
    "hooks": {}
  },
  "dependencies": {
    "@cenk1cenk2/oclif-common": "^8.0.5",
    "@listr2/manager": "^4.3.4",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@oclif/core": "^5.1.12",
    "@oxc-project/runtime": "^0.159.0",
    "es-toolkit": "^1.53.2",
    "jsondiffpatch": "^0.7.7",
    "listr2": "^11.4.1",
    "renovate": "^44.252.7",
    "source-map-support": "^0.5.21",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cenk1cenk2/cz-cc": "^3.0.13",
    "@cenk1cenk2/eslint-config": "^3.4.8",
    "@tsconfig/node26": "^26.0.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "execa": "^10.2.1",
    "globby": "^16.2.4",
    "oclif": "^6.0.15",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@cenk1cenk2/cz-cc"
    }
  },
  "packageManager": "pnpm@12.22.0"
}
