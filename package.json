{
  "name": "@cenk1cenk2/renovate-config",
  "version": "5.0.0",
  "description": "Renovate configuration generator for repositories.",
  "author": "Cenk Kilic",
  "license": "GPL-3.0-or-later",
  "repository": "https://gitlab.kilic.dev/renovate/renovate-config",
  "type": "module",
  "bin": {
    "renovate-config-generator": "./bin/run.js"
  },
  "files": [
    "/config",
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "dev": "./bin/dev.js",
    "start": "./bin/run.js",
    "build": "tsdown",
    "dev:start": "tsdown --watch src/",
    "format": "prettier --log-level warn --write ./ && eslint --fix ./src",
    "lint": "eslint ./src",
    "test": "vitest run",
    "manifest": "oclif manifest",
    "test:watch": "vitest"
  },
  "oclif": {
    "bin": "renovate-config-generator",
    "dirname": "renovate-config-generator",
    "commands": {
      "strategy": "single",
      "target": "./dist/commands/index.js"
    },
    "plugins": [],
    "hooks": {}
  },
  "dependencies": {
    "@cenk1cenk2/oclif-common": "^7.1.0",
    "@listr2/manager": "^4.2.5",
    "@oclif/core": "^5.0.0",
    "@oxc-project/runtime": "^0.150.0",
    "fs-extra": "^11.4.0",
    "jsondiffpatch": "^0.7.6",
    "listr2": "^11.1.0",
    "renovate": "^44.91.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@cenk1cenk2/cz-cc": "^3.0.1",
    "@cenk1cenk2/eslint-config": "^3.3.6",
    "@tsconfig/node24": "^24.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.6",
    "eslint": "^10.10.0",
    "execa": "^10.0.1",
    "globby": "^16.2.4",
    "oclif": "^6.0.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@cenk1cenk2/cz-cc"
    }
  },
  "packageManager": "pnpm@12.4.2"
}
